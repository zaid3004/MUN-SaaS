# Supabase PostgreSQL Connection
# Get this from your Supabase project settings > Database > Connection string
# Use the "psycopg2" connection string
DATABASE_URL=postgresql://postgres:password@db.supabasehost.com:5432/postgres

# Flask Secret Key (generate a strong random string for production)
SECRET_KEY=your-super-secret-key-here-change-in-production

# Storage backend (local or r2)
STORAGE_BACKEND=local

# If using S3/R2 storage, add these:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_ENDPOINT_URL=your-r2-endpoint
